# ===================================================================
# FREE CLOUD DATABASE CONFIGURATION
# (Choose either MongoDB Atlas OR Supabase/PostgreSQL)
# ===================================================================

# OPTION 1: MongoDB Atlas (Recommended - 512MB Free Forever, No Credit Card)
# Sign up at: https://www.mongodb.com/cloud/atlas/register
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/yatra_desk?retryWrites=true&w=majority

# OPTION 2: Supabase or Neon PostgreSQL (Free Tier)
# Sign up at: https://supabase.com or https://neon.tech
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# (If neither is set, Yatra Desk automatically runs on local SQLite in ./data)
DATA_DIR=./data
